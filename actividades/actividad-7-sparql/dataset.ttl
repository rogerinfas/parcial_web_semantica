@prefix : <https://ejemplo.org/videojuegos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ejemplo.org/videojuegos> a owl:Ontology ;
    rdfs:label "Ontología de videojuegos para prácticas SPARQL"@es .

### Clases
:Videojuego a owl:Class .
:Desarrollador a owl:Class .
:Genero a owl:Class .
:Plataforma a owl:Class .

### Propiedades de objeto
:tieneDesarrollador a owl:ObjectProperty ;
    rdfs:domain :Videojuego ;
    rdfs:range :Desarrollador .

:tieneGenero a owl:ObjectProperty ;
    rdfs:domain :Videojuego ;
    rdfs:range :Genero .

:disponibleEn a owl:ObjectProperty ;
    rdfs:domain :Videojuego ;
    rdfs:range :Plataforma .

### Propiedades de datos
:nombre a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:anioLanzamiento a owl:DatatypeProperty ;
    rdfs:domain :Videojuego ;
    rdfs:range xsd:integer .

:precio a owl:DatatypeProperty ;
    rdfs:domain :Videojuego ;
    rdfs:range xsd:decimal .

:calificacion a owl:DatatypeProperty ;
    rdfs:domain :Videojuego ;
    rdfs:range xsd:decimal .

### Desarrolladores
:TeamCherry a :Desarrollador ; :nombre "Team Cherry" .
:Nintendo a :Desarrollador ; :nombre "Nintendo" .
:ConcernedApe a :Desarrollador ; :nombre "ConcernedApe" .
:MaddyMakesGames a :Desarrollador ; :nombre "Maddy Makes Games" .
:FromSoftware a :Desarrollador ; :nombre "FromSoftware" .
:CDProjektRed a :Desarrollador ; :nombre "CD Projekt Red" .

### Géneros
:Metroidvania a :Genero ; :nombre "Metroidvania" .
:Aventura a :Genero ; :nombre "Aventura" .
:Simulacion a :Genero ; :nombre "Simulación" .
:Plataformas a :Genero ; :nombre "Plataformas" .
:RPG a :Genero ; :nombre "RPG" .
:AccionRPG a :Genero ; :nombre "Acción RPG" .

### Plataformas
:PC a :Plataforma ; :nombre "PC" .
:Switch a :Plataforma ; :nombre "Nintendo Switch" .
:PlayStation5 a :Plataforma ; :nombre "PlayStation 5" .
:XboxSeries a :Plataforma ; :nombre "Xbox Series X/S" .

### Videojuegos
:HollowKnight a :Videojuego ;
